# Copy to .env; fill local DB credentials and a new random JWT_SECRET.
# 3307 is the source dev port. Match frontend DATABASE_URL if using 3306 instead.
# Setup guide: ../../docs/LOCAL_TEST_SETUP.md
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USERNAME=ctdt_dev
DB_PASSWORD=
DB_DATABASE=ctdt_management
PORT=3002
JWT_SECRET=
FRONTEND_URL=http://localhost:3000

# Gmail: enable 2-step verification and create a Google app password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional: defaults to SMTP_USER.
SMTP_FROM=

# Only for db:bootstrap on a new EMPTY database; not needed after restoring SQL.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=
