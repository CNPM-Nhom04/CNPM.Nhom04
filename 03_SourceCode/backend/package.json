{
  "name": "backend",
  "version": "1.0.0",
  "description": "NestJS Backend for CTDT System",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "check:smtp": "node scripts/check-smtp.cjs",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/core/database/data-source.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --max-warnings=0",
    "lint:fix": "npm run lint -- --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:auth-integration": "node test/auth.integration.cjs",
    "test:admin-integration": "node test/admin.integration.cjs",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:program-integration": "node test/program.integration.cjs",
    "test:program-parity": "node test/program-data-parity.cjs",
    "test:program-scope": "node test/program-scope.integration.cjs",
    "test:defense-integration": "node test/thesis-defense.integration.cjs",
    "test:course-integration": "node test/course.integration.cjs",
    "test:course-parity": "node test/course-data-parity.cjs",
    "test:topic-integration": "node test/thesis-topic.integration.cjs",
    "test:topic-parity": "node test/thesis-topic-parity.cjs",
    "test:topic-browser": "node test/thesis-topic.browser.cjs",
    "test:grade-integration": "node test/grade.integration.cjs",
    "test:grade-parity": "node test/grade-data-parity.cjs",
    "test:grade-browser": "node test/grade.browser.cjs",
    "test:comparison-integration": "node test/comparison.integration.cjs",
    "test:comparison-browser": "node test/comparison.browser.cjs",
    "test:approval-parity": "node test/approval-data-parity.cjs",
    "test:approval-integration": "node test/approval.integration.cjs",
    "test:approval-browser": "node test/approval.browser.cjs",
    "test:graduation-parity": "node test/graduation-data-parity.cjs",
    "test:graduation-integration": "node test/graduation.integration.cjs",
    "test:graduation-browser": "node test/graduation.browser.cjs",
    "test:major-parity": "node test/major-data-parity.cjs",
    "test:major-integration": "node test/major.integration.cjs",
    "test:major-browser": "node test/major.browser.cjs",
    "test:major-excel-integration": "node test/major-excel.integration.cjs",
    "test:major-excel-browser": "node test/major-excel.browser.cjs",
    "test:faculty-export-integration": "node test/faculty-export.integration.cjs",
    "test:faculty-export-browser": "node test/faculty-export.browser.cjs",
    "test:portal-integration": "node test/public-portal.integration.cjs",
    "test:portal-browser": "node test/public-portal.browser.cjs",
    "test:student-program-integration": "node test/student-program.integration.cjs",
    "test:student-program-browser": "node test/student-program.browser.cjs",
    "test:student-accounts-integration": "node test/student-accounts.integration.cjs",
    "test:student-accounts-browser": "node test/student-accounts.browser.cjs",
    "test:access-matrix-integration": "node test/access-matrix.integration.cjs",
    "test:access-matrix-browser": "node test/access-matrix.browser.cjs",
    "test:student-account-link-integration": "node test/student-account-link.integration.cjs",
    "test:student-account-link-browser": "node test/student-account-link.browser.cjs",
    "test:program-course-forms-integration": "node test/program-course-forms.integration.cjs",
    "test:program-course-forms-browser": "node test/program-course-forms.browser.cjs",
    "test:public-catalog-integration": "node test/public-catalog.integration.cjs",
    "test:public-catalog-browser": "node test/public-catalog.browser.cjs",
    "db:bootstrap": "node scripts/database/bootstrap.cjs",
    "migration:run:prod": "typeorm migration:run -d dist/core/database/data-source.js",
    "test:qa-integration": "node test/qa-regression.integration.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/typeorm": "^11.0.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "exceljs": "^4.4.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^8.0.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "overrides": {
    "multer": "^2.5.0"
  }
}
