# Copy to .env. Backend DB_* and this URL must point to the SAME MariaDB database.
# 3307 matches the source dev machine; change BOTH env files to 3306 if needed.
# Replace the user/password with credentials created on the receiving machine.
# Percent-encode special characters in the URL password.
DATABASE_URL="mysql://ctdt_dev:CHANGE_ME@127.0.0.1:3307/ctdt_management"

# NestJS URL as seen by the Next.js server, not the browser.
BACKEND_API_URL=http://127.0.0.1:3002

# Full clone/restore/install instructions: ../../docs/LOCAL_TEST_SETUP.md
# Prisma CLI loads .env; a pre-existing .env.local can override Next.js values.

# Public origin seen in the browser; required behind a reverse proxy.
# Leave unset for direct local development on localhost/127.0.0.1.
# APP_ORIGIN=https://ctdt.example.edu
# Optional comma-separated additional trusted public origins. No wildcards.
# TRUSTED_ORIGINS=https://qa.ctdt.example.edu
