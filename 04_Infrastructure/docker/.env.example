# Copy to .env here; use separate credentials/env files per deployment.
DB_PASSWORD=
# Same password, percent-encoded for use in DATABASE_URL.
DB_PASSWORD_URLENCODED=
DB_ROOT_PASSWORD=
JWT_SECRET=
BOOTSTRAP_ADMIN_PASSWORD=
# Development only. Staging/prod must use the actual public HTTPS origin.
APP_ORIGIN=http://localhost:3000
DB_HOST_PORT=3308

# Optional email testing; leave credentials blank to run without SMTP.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
